        <mxCell id="-Ce63cUNF13zfrmySoGz-17" value="Association: Models a semantic connection among classes" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="-Ce63cUNF13zfrmySoGz-16">
          <mxGeometry width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="-Ce63cUNF13zfrmySoGz-18" value="aggregation:&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;A special form of association that models a whole-part relation ship&lt;/span&gt;&lt;div&gt;between an aggregate(the whole)and its parts&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="-Ce63cUNF13zfrmySoGz-16">
          <mxGeometry x="10" y="60" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="-Ce63cUNF13zfrmySoGz-19" value="composition:&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;A form of aggregation with strong ownership and coincident lifetimes&lt;/span&gt;&lt;div&gt;•The parts cannot survive the the whole/aggregate&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="-Ce63cUNF13zfrmySoGz-16">
          <mxGeometry x="10" y="150" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="-Ce63cUNF13zfrmySoGz-20" value="Dependency: A relationship between two model elements where a change in one may cause a change in the other" style="text;whiteSpace=wrap;" vertex="1" parent="-Ce63cUNF13zfrmySoGz-16">
          <mxGeometry x="10" y="220" width="310" height="50" as="geometry" />
        </mxCell>
        <mxCell id="-Ce63cUNF13zfrmySoGz-21" value="Generalization: Defines a hierarchy of abstractions in which a subclass Inherits from one or more&#xa;superclasses&#xa;&#xa;" style="text;whiteSpace=wrap;" vertex="1" parent="-Ce63cUNF13zfrmySoGz-16">
          <mxGeometry x="5" y="297" width="310" height="50" as="geometry" />
        </mxCell>
        <mxCell id="-Ce63cUNF13zfrmySoGz-22" value="&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;Model layer entities: &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;blue&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;&quot;&gt;&amp;nbsp;The Controller Layer (Logic): &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;green&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;&quot;&gt;&amp;nbsp;the view layer&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;red&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=default;labelBackgroundColor=none;" vertex="1" parent="1">
