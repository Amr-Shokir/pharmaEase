          <mxGeometry x="30" y="120" width="617" height="537" as="geometry" />
        </mxCell>
        <mxCell id="5jmCC5D497CZPQc9R1hy-2" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;how to draw the ERD&amp;nbsp;&lt;/h1&gt;&lt;div&gt;1. draw the relations&amp;nbsp;&lt;/div&gt;&lt;div&gt;2. figure out each relationship cardinality &amp;amp; participation&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;a. how many A&#39;s can be linked to one B? (many - N)&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;b. how many B&#39;s can be linked to one A? (many - N)&amp;nbsp;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;a. can an A exist without a B? (no - total)&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;b. can a B exist without an A? (yes - partial)&lt;br&gt;&lt;/div&gt;&lt;div&gt;3. put the cardinality &amp;amp; participation on the side of the other relation&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="157" y="737" width="490" height="260" as="geometry" />
        </mxCell>
